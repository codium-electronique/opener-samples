#include "nrf91x1_partition_without_bootloader.dtsi"
#include "nrf91x1_dect_modem.dtsi"

/ {
	chosen {
		opener,spinel-uart = &uart0;
	};
};

&uart0 {
	current-speed = <1000000>;
	/* Without it, the UARTE loses received bytes when its interrupt is served
	 * late, about one host frame in 4000 at 1 Mbaud. The interface MCU of
	 * the DK and EK follows RTS.
	 */
	hw-flow-control;
};
